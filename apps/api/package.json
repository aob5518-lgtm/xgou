{
  "name": "@xgou/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests",
    "test:integration": "vitest run test"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/throttler": "latest",
    "@xgou/database": "workspace:*",
    "@xgou/chains": "workspace:*",
    "@xgou/contracts": "workspace:*",
    "@xgou/ledger": "workspace:*",
    "@xgou/market-data": "workspace:*",
    "@xgou/referral-engine": "workspace:*",
    "@xgou/reward-engine": "workspace:*",
    "@xgou/risk-engine": "workspace:*",
    "@xgou/shared": "workspace:*",
    "@xgou/strategy-engine": "workspace:*",
    "@xgou/exchange-adapters": "workspace:*",
    "@xgou/xp-engine": "workspace:*",
    "cookie-parser": "latest",
    "decimal.js": "latest",
    "helmet": "latest",
    "reflect-metadata": "latest",
    "redis": "latest",
    "rxjs": "latest",
    "siwe": "latest",
    "viem": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/testing": "latest",
    "@types/cookie-parser": "latest",
    "@types/express": "latest",
    "supertest": "latest",
    "@types/supertest": "latest",
    "vitest": "latest"
