NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://xgou:xgou_dev_only@localhost:5432/xgou?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-char-secret
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
CHAIN_ENV=arc-testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_EXPLORER_URL=https://explorer.testnet.arc.io
ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
MAINNET_ENABLED=false
EXECUTION_MODE=DRY_RUN
KEY_PROVIDER=disabled
CREDENTIAL_PROVIDER=disabled
GLOBAL_RISK_ENABLED=false
PRODUCTION_READINESS_ENFORCED=true
LIVE_EXCHANGE_TRANSPORT_ENABLED=false
TREASURY_DRY_RUN_ENABLED=false
ENABLE_DRY_RUN_EXECUTION=false
ENABLE_SANDBOX_EXCHANGE=false
SANDBOX_EXCHANGE_TRANSPORT_ENABLED=false
BINANCE_ENVIRONMENT=TESTNET
# Secret values must be resolved by CredentialProvider. Never expose these as NEXT_PUBLIC_*.
BINANCE_SPOT_CREDENTIAL_REFERENCE=vault://exchange/binance-testnet/spot
BINANCE_FUTURES_CREDENTIAL_REFERENCE=vault://exchange/binance-testnet/futures
BINANCE_SANDBOX_MAX_LEVERAGE=2
BINANCE_SANDBOX_MAX_ORDER_NOTIONAL=100
BINANCE_SANDBOX_DAILY_NOTIONAL_LIMIT=1000
BINANCE_SANDBOX_MAX_ORDERS_PER_MINUTE=5
BINANCE_SANDBOX_MAX_ORDERS_PER_HOUR=20
BINANCE_SANDBOX_E2E_SPOT_NOTIONAL=10
BINANCE_SANDBOX_E2E_FUTURES_QUANTITY=0.002
ENABLE_TREASURY_DRY_RUN=false
ENABLE_GLOBAL_RISK_WORKER=false
ENABLE_PRODUCTION_RECONCILIATION=false
ENABLE_OPERATIONAL_ALERTS=false
REAL_TRADING_ENABLED=false
REAL_WITHDRAWALS_ENABLED=false
SPOT_PAPER_TRADING_ENABLED=false
MARKET_DATA_SOURCE=fixture
SPOT_STRATEGY_CYCLE_SECONDS=60
SPOT_TRADING_FEE_BPS=10
SPOT_BASE_SLIPPAGE_BPS=5
FUTURES_PAPER_TRADING_ENABLED=false
FUTURES_STRATEGY_CYCLE_SECONDS=60
FUTURES_MARKET_DATA_SOURCE=fixture
REWARD_MODE=PAPER
REWARD_SETTLEMENT_ENABLED=false
REWARD_AUTO_CALCULATE_ENABLED=false
REAL_REWARD_DISTRIBUTION_ENABLED=false
IP_HASH_SALT=replace-with-a-random-environment-specific-salt
DEMO_MODE=true
NEXT_PUBLIC_ENABLE_WEBGL_BRAIN=false
DEPOSITS_ENABLED=true
CHAIN_INDEXER_ENABLED=false
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=120000
RECONCILIATION_DUST_THRESHOLD=0.000001
