generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  OPERATOR
  RISK_MANAGER
  ADMIN
}

enum ParticipationStatus {
  PENDING
  EFFECTIVE
  CANCELLED
}

enum RiskFlagStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum FundDomain {
  BULL
  SPOT
  FUTURES
  REWARD
  WITHDRAWAL
  ECOSYSTEM
  PLATFORM
}

enum LedgerAccountType {
  DEPOSIT_CLEARING
  USER_PRINCIPAL
  BULL_VAULT
  SPOT_TREASURY
  SPOT_STRATEGY
  FUTURES_TREASURY
  FUTURES_STRATEGY
  REWARD_VAULT
  REWARD_PAYABLE
  WITHDRAWAL_BUFFER
  ECOSYSTEM_FUND
  PLATFORM_TREASURY
  FEE_EXPENSE
  TRADING_PNL
  FUNDING_EXPENSE
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum LedgerTransactionKind {
  DEPOSIT_CONFIRMATION
  FUND_ALLOCATION
  TREASURY_REBALANCE
  MANUAL_ADJUSTMENT
  REVERSAL
}

enum DepositStatus {
  CREATED
  AWAITING_APPROVAL
  AWAITING_TX
  TX_SUBMITTED
  CHAIN_CONFIRMED
  ALLOCATING
  COMPLETED
  FAILED
  REJECTED
}

enum OnchainEventStatus {
  FINALIZED
  PROCESSED
  FAILED
  REVIEW
}

enum ReconciliationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ReconciliationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ReconciliationRunStatus {
  RUNNING
  PASSED
  FAILED
}

enum ContractVerificationStatus {
  NOT_VERIFIED
  VERIFIED
  FAILED
}

enum FundAllocationStatus {
  PENDING
  POSTED
  REVERSED
}

enum AccountStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum VaultKind {
  BULL_MASTER
  SPOT_STRATEGY
  FUTURES_STRATEGY
  REWARD
  ECOSYSTEM
}

enum TreasuryAccountKind {
  DEPOSIT_CLEARING
  SPOT_STRATEGY
  FUTURES_STRATEGY
  WITHDRAWAL_BUFFER
  PLATFORM_OPERATING
}

enum StrategyType {
  SPOT_SWING
  FUTURES_TREND
}

enum StrategyStatus {
  DRAFT
  PAPER
  PAUSED
  RISK_OFF
  DISABLED
}

enum StrategyAccountStatus {
  ACTIVE
  PAUSED
  RISK_OFF
}

enum SignalType {
  BUY
  LONG
  SHORT
  REDUCE
  EXIT
  HOLD
}

enum ProposalSide {
  BUY
  OPEN_LONG
  OPEN_SHORT
  REDUCE_LONG
  REDUCE_SHORT
  CLOSE_LONG
  CLOSE_SHORT
  REDUCE
  EXIT
}

enum ProposalStatus {
  CREATED
  RISK_APPROVED
  RISK_REDUCED
  RISK_REJECTED
  EXECUTED
  CANCELLED
}

enum RiskDecisionType {
  APPROVED
  REDUCED
  REJECTED
}

enum PaperOrderStatus {
  CREATED
  RISK_APPROVED
  SUBMITTED
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  REJECTED
  LIQUIDATED
}

enum PaperOrderType {
  MARKET
  LIMIT
}

enum PaperSide {
  BUY
  SELL
}

enum PositionStatus {
  OPEN
  CLOSED
  FORCED_CLOSED
  LIQUIDATED
}

enum FuturesPositionSide {
  LONG
  SHORT
}

enum CircuitBreakerStatus {
  RUNNING
  REDUCED_RISK
  PAUSED
  RISK_OFF
}

enum StrategyCycleStatus {
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum StrategyActivityType {
  RESEARCH
  SIGNAL
  PROPOSAL
  RISK
  EXECUTION
  SYSTEM
}

enum RewardMode {
  PAPER
  REAL
}

enum RewardEpochStatus {
  OPEN
  CALCULATING
  REVIEW
  FINALIZED
  CANCELLED
}

enum UserRewardStatus {
  PENDING
  AVAILABLE
  WITHDRAWN
  CANCELLED
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  walletAddress       String             @unique @db.VarChar(42)
  role                UserRole           @default(USER)
  deviceFingerprint   String?            @db.VarChar(128)
  registrationIpHash  String?            @db.VarChar(64)
  riskScore           Decimal            @default(0) @db.Decimal(8, 4)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  sessions            RefreshSession[]
  inviterEdge         ReferralEdge?      @relation("ReferralDescendant")
  directReferrals     ReferralEdge[]     @relation("ReferralAncestor")
  referralAncestors   ReferralClosure[]  @relation("ClosureDescendant")
  referralDescendants ReferralClosure[]  @relation("ClosureAncestor")
  participations      Participation[]
  principalXpEntries  PrincipalXpEntry[]
  xpSnapshots         XpSnapshot[]
  riskFlags           RiskFlag[]
  deposits            Deposit[]
  ledgerAccounts      LedgerAccount[]
  chainAccounts       ChainAccount[]
  rewardAllocations   UserRewardAllocation[]
}

model AuthNonce {
  id            String    @id @default(uuid()) @db.Uuid
  walletAddress String    @db.VarChar(42)
  nonceHash     String    @unique @db.VarChar(64)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([walletAddress, expiresAt])
}

model RefreshSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.VarChar(64)
  expiresAt     DateTime
  revokedAt     DateTime?
  rotatedFromId String?   @db.Uuid
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ReferralEdge {
  userId        String   @id @db.Uuid
  inviterUserId String   @db.Uuid
  createdAt     DateTime @default(now())
  user          User     @relation("ReferralDescendant", fields: [userId], references: [id], onDelete: Restrict)
  inviter       User     @relation("ReferralAncestor", fields: [inviterUserId], references: [id], onDelete: Restrict)

  @@index([inviterUserId])
  @@index([createdAt])
}

model ReferralClosure {
  ancestorId   String   @db.Uuid
  descendantId String   @db.Uuid
  depth        Int
  createdAt    DateTime @default(now())
  ancestor     User     @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Restrict)
  descendant   User     @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Restrict)

  @@id([ancestorId, descendantId])
  @@index([ancestorId, depth])
  @@index([descendantId, depth])
}

model Participation {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  amount      Decimal             @db.Decimal(36, 18)
  asset       String              @db.VarChar(12)
  status      ParticipationStatus @default(PENDING)
  externalRef String              @unique @db.VarChar(128)
  effectiveAt DateTime?
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  principalXp PrincipalXpEntry?

  @@index([userId, status])
}

model PrincipalXpEntry {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  amount          Decimal       @db.Decimal(36, 18)
  participationId String        @unique @db.Uuid
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  participation   Participation @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model RewardEpoch {
  id                        String            @id @default(uuid()) @db.Uuid
  number                    Int
  startsAt                  DateTime
  endsAt                    DateTime
  status                    RewardEpochStatus @default(OPEN)
  mode                      RewardMode        @default(PAPER)
  configVersion             Int               @default(1)
  spotStartNav              Decimal           @default(0) @db.Decimal(36, 18)
  spotEndNav                Decimal           @default(0) @db.Decimal(36, 18)
  spotRealizedGross         Decimal           @default(0) @db.Decimal(36, 18)
  spotFees                  Decimal           @default(0) @db.Decimal(36, 18)
  spotSlippage              Decimal           @default(0) @db.Decimal(36, 18)
  spotNetRealized           Decimal           @default(0) @db.Decimal(36, 18)
  futuresStartNav           Decimal           @default(0) @db.Decimal(36, 18)
  futuresEndNav             Decimal           @default(0) @db.Decimal(36, 18)
  futuresRealizedGross      Decimal           @default(0) @db.Decimal(36, 18)
  futuresFunding            Decimal           @default(0) @db.Decimal(36, 18)
  futuresFees               Decimal           @default(0) @db.Decimal(36, 18)
  futuresLiquidationPenalty Decimal           @default(0) @db.Decimal(36, 18)
  futuresSlippage           Decimal           @default(0) @db.Decimal(36, 18)
  futuresNetRealized        Decimal           @default(0) @db.Decimal(36, 18)
  grossNetRealized          Decimal           @default(0) @db.Decimal(36, 18)
  lossCarryforwardBefore    Decimal           @default(0) @db.Decimal(36, 18)
  lossCarryforwardApplied   Decimal           @default(0) @db.Decimal(36, 18)
  lossCarryforwardAfter     Decimal           @default(0) @db.Decimal(36, 18)
  hwmBefore                 Decimal           @default(0) @db.Decimal(36, 18)
  hwmAfter                  Decimal           @default(0) @db.Decimal(36, 18)
  distributableProfit       Decimal           @default(0) @db.Decimal(36, 18)
  riskReserve               Decimal           @default(0) @db.Decimal(36, 18)
  rewardPool                Decimal           @default(0) @db.Decimal(36, 18)
  totalEffectiveXp          Decimal           @default(0) @db.Decimal(36, 18)
  rewardDust                Decimal           @default(0) @db.Decimal(36, 18)
  error                     String?            @db.VarChar(1024)
  settledAt                 DateTime?
  finalizedAt               DateTime?
  createdAt                 DateTime           @default(now())
  config                    SystemConfigVersion @relation(fields: [configVersion], references: [version], onDelete: Restrict)
  snapshots                 XpSnapshot[]
  settlementBaselines       EpochSettlementBaseline[]
  sourceSnapshots           SettlementSourceSnapshot[]
  allocations               UserRewardAllocation[]
  auditEvents               RewardAuditEvent[]
  finalizedFundState        RewardFundState?   @relation("LastFinalizedRewardEpoch")

  @@unique([mode, number])
  @@unique([mode, startsAt])
  @@index([status, endsAt])
}

model XpSnapshot {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @db.Uuid
  rewardEpochId       String      @db.Uuid
  principalXp         Decimal     @db.Decimal(36, 18)
  dynamicXp           Decimal     @db.Decimal(36, 18)
  totalXp             Decimal     @db.Decimal(36, 18)
  directReferralCount Int
  unlockedDepth       Int
  networkPrincipalXp  Decimal     @db.Decimal(36, 18)
  snapshotAt          DateTime    @default(now())
  user                User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  rewardEpoch         RewardEpoch @relation(fields: [rewardEpochId], references: [id], onDelete: Restrict)

  @@unique([userId, rewardEpochId])
  @@index([rewardEpochId])
}

model SystemConfigVersion {
  id              String           @id @default(uuid()) @db.Uuid
  version         Int              @unique
  values          Json
  effectiveAt     DateTime
  createdBy       String           @db.VarChar(128)
  createdAt       DateTime         @default(now())
  fundAllocations FundAllocation[]
  deposits        Deposit[]
  rewardEpochs    RewardEpoch[]

  @@index([effectiveAt])
}

model LedgerAccount {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(128)
  type        LedgerAccountType
  fundDomain  FundDomain?
  ownerUserId String?           @db.Uuid
  asset       String            @db.VarChar(12)
  status      AccountStatus     @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  ownerUser   User?             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  entries     LedgerEntry[]
  vault       Vault?
  treasury    TreasuryAccount?

  @@index([type, asset])
  @@index([fundDomain, status])
  @@index([ownerUserId, type])
}

model LedgerTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  kind           LedgerTransactionKind
  idempotencyKey String                @unique @db.VarChar(128)
  referenceType  String                @db.VarChar(64)
  referenceId    String                @db.VarChar(128)
  description    String                @db.VarChar(512)
  effectiveAt    DateTime
  createdAt      DateTime              @default(now())
  entries        LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([effectiveAt])
}

model LedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @db.Uuid
  accountId     String            @db.Uuid
  side          LedgerSide
  amount        Decimal           @db.Decimal(36, 18)
  asset         String            @db.VarChar(12)
  fundDomain    FundDomain?
  memo          String?           @db.VarChar(256)
  createdAt     DateTime          @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@index([fundDomain, asset])
}

model Deposit {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @db.Uuid
  asset          String                 @db.VarChar(12)
  amount         Decimal                @db.Decimal(36, 18)
  chainId        String                 @db.VarChar(64)
  tokenDecimals  Int
  configVersion  Int?
  externalRef    String                 @unique @db.VarChar(160)
  idempotencyKey String                 @unique @db.VarChar(128)
  status         DepositStatus          @default(CREATED)
  confirmedAt    DateTime?
  allocatedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  config         SystemConfigVersion?   @relation(fields: [configVersion], references: [version], onDelete: Restrict)
  allocations    FundAllocation[]
  chainReference DepositChainReference?

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([configVersion])
}

model ChainAccount {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  chainId       String   @db.VarChar(64)
  walletAddress String   @db.VarChar(42)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([chainId, walletAddress])
  @@unique([userId, chainId])
  @@index([userId])
}

model TokenRegistry {
  id             String   @id @default(uuid()) @db.Uuid
  chainId        String   @db.VarChar(64)
  symbol         String   @db.VarChar(12)
  address        String   @db.VarChar(42)
  decimals       Int
  isGasToken     Boolean  @default(false)
  isDepositAsset Boolean  @default(false)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([chainId, address])
  @@index([chainId, symbol])
}

model ContractDeployment {
  id                 String                     @id @default(uuid()) @db.Uuid
  chainId            String                     @db.VarChar(64)
  contractName       String                     @db.VarChar(64)
  address            String                     @db.VarChar(42)
  version            String                     @db.VarChar(32)
  deploymentTxHash   String                     @db.VarChar(66)
  deploymentBlock    BigInt
  verificationStatus ContractVerificationStatus @default(NOT_VERIFIED)
  deployedAt         DateTime
  createdAt          DateTime                   @default(now())

  @@unique([chainId, address])
  @@unique([chainId, contractName, version])
}

model ChainCursor {
  id                 String   @id @default(uuid()) @db.Uuid
  chainId            String   @db.VarChar(64)
  contractAddress    String   @db.VarChar(42)
  eventName          String   @db.VarChar(64)
  lastProcessedBlock BigInt
  lastBlockHash      String?  @db.VarChar(66)
  updatedAt          DateTime @updatedAt

  @@unique([chainId, contractAddress, eventName])
}

model OnchainEvent {
  id              String             @id @default(uuid()) @db.Uuid
  chainId         String             @db.VarChar(64)
  contractAddress String             @db.VarChar(42)
  txHash          String             @db.VarChar(66)
  logIndex        Int
  blockNumber     BigInt
  blockHash       String             @db.VarChar(66)
  eventName       String             @db.VarChar(64)
  payload         Json
  finalizedAt     DateTime
  processedAt     DateTime?
  status          OnchainEventStatus @default(FINALIZED)
  error           String?            @db.VarChar(512)
  createdAt       DateTime           @default(now())

  @@unique([chainId, txHash, logIndex])
  @@index([chainId, contractAddress, blockNumber])
  @@index([status, createdAt])
}

model DepositChainReference {
  id              String   @id @default(uuid()) @db.Uuid
  depositId       String   @unique @db.Uuid
  chainId         String   @db.VarChar(64)
  clientReference String   @db.VarChar(66)
  walletAddress   String   @db.VarChar(42)
  routerAddress   String   @db.VarChar(42)
  assetAddress    String   @db.VarChar(42)
  txHash          String?  @db.VarChar(66)
  logIndex        Int?
  blockNumber     BigInt?
  blockHash       String?  @db.VarChar(66)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deposit         Deposit  @relation(fields: [depositId], references: [id], onDelete: Restrict)

  @@unique([chainId, walletAddress, clientReference])
  @@unique([chainId, txHash])
  @@index([clientReference])
}

model ReconciliationDifference {
  id              String                 @id @default(uuid()) @db.Uuid
  chainId         String                 @db.VarChar(64)
  fundDomain      FundDomain
  internalBalance Decimal                @db.Decimal(36, 18)
  externalBalance Decimal                @db.Decimal(36, 18)
  difference      Decimal                @db.Decimal(36, 18)
  detectedAt      DateTime               @default(now())
  status          ReconciliationStatus   @default(OPEN)
  severity        ReconciliationSeverity
  runId           String?                @db.Uuid
  resolvedAt      DateTime?
  run             ReconciliationRun?     @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([chainId, fundDomain, status])
  @@index([severity, detectedAt])
  @@index([runId])
}

model ReconciliationRun {
  id              String                     @id @default(uuid()) @db.Uuid
  startedAt       DateTime                   @default(now())
  finishedAt      DateTime?
  status          ReconciliationRunStatus    @default(RUNNING)
  chainId         String                     @db.VarChar(64)
  bullInternal    Decimal?                   @db.Decimal(36, 18)
  bullExternal    Decimal?                   @db.Decimal(36, 18)
  spotInternal    Decimal?                   @db.Decimal(36, 18)
  spotExternal    Decimal?                   @db.Decimal(36, 18)
  futuresInternal Decimal?                   @db.Decimal(36, 18)
  futuresExternal Decimal?                   @db.Decimal(36, 18)
  criticalCount   Int                        @default(0)
  error           String?                    @db.VarChar(1024)
  differences     ReconciliationDifference[]

  @@index([chainId, startedAt])
  @@index([status, startedAt])
}

model FundAllocation {
  id              String               @id @default(uuid()) @db.Uuid
  depositId       String               @db.Uuid
  fundDomain      FundDomain
  amount          Decimal              @db.Decimal(36, 18)
  ratio           Decimal              @db.Decimal(36, 18)
  configVersion   Int
  status          FundAllocationStatus @default(PENDING)
  ledgerReference String               @db.VarChar(128)
  createdAt       DateTime             @default(now())
  postedAt        DateTime?
  deposit         Deposit              @relation(fields: [depositId], references: [id], onDelete: Restrict)
  config          SystemConfigVersion  @relation(fields: [configVersion], references: [version], onDelete: Restrict)

  @@unique([depositId, fundDomain])
  @@index([fundDomain, status])
  @@index([configVersion])
}

model Vault {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique @db.VarChar(128)
  kind            VaultKind
  fundDomain      FundDomain
  asset           String        @db.VarChar(12)
  ledgerAccountId String        @unique @db.Uuid
  status          AccountStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([fundDomain, status])
}

model TreasuryAccount {
  id              String              @id @default(uuid()) @db.Uuid
  code            String              @unique @db.VarChar(128)
  kind            TreasuryAccountKind
  fundDomain      FundDomain?
  asset           String              @db.VarChar(12)
  ledgerAccountId String              @unique @db.Uuid
  status          AccountStatus       @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  ledgerAccount   LedgerAccount       @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([fundDomain, status])
}

model RiskFlag {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  reason    String         @db.VarChar(128)
  evidence  Json
  score     Decimal        @db.Decimal(8, 4)
  status    RiskFlagStatus @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String   @db.VarChar(128)
  target    String   @db.VarChar(256)
  before    Json?
  after     Json?
  ipHash    String?  @db.VarChar(64)
  requestId String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([requestId])
}

model Strategy {
  id             String               @id @default(uuid()) @db.Uuid
  code           String               @unique @db.VarChar(64)
  name           String               @db.VarChar(128)
  type           StrategyType
  fundDomain     FundDomain           @default(SPOT)
  status         StrategyStatus       @default(DRAFT)
  currentVersion Int                  @default(1)
  riskProfile    Json
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  versions       StrategyVersion[]
  account        StrategyAccount?
  signals        TradeSignal[]
  proposals      TradeProposal[]
  cycles         StrategyCycle[]
  circuitBreaker CircuitBreakerState?
  activities     StrategyActivity[]
}

model StrategyVersion {
  id         String   @id @default(uuid()) @db.Uuid
  strategyId String   @db.Uuid
  version    Int
  parameters Json
  active     Boolean  @default(false)
  createdAt  DateTime @default(now())
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Restrict)

  @@unique([strategyId, version])
}

model StrategyAccount {
  id                String                @id @default(uuid()) @db.Uuid
  strategyId        String                @unique @db.Uuid
  status            StrategyAccountStatus @default(ACTIVE)
  asset             String                @default("USDC") @db.VarChar(12)
  allocatedCapital  Decimal               @default(0) @db.Decimal(36, 18)
  activeCapital     Decimal               @default(0) @db.Decimal(36, 18)
  cashBalance       Decimal               @default(0) @db.Decimal(36, 18)
  reserveBalance    Decimal               @default(0) @db.Decimal(36, 18)
  nav               Decimal               @default(0) @db.Decimal(36, 18)
  equity            Decimal               @default(0) @db.Decimal(36, 18)
  highWaterMark     Decimal               @default(0) @db.Decimal(36, 18)
  realizedPnl       Decimal               @default(0) @db.Decimal(36, 18)
  unrealizedPnl     Decimal               @default(0) @db.Decimal(36, 18)
  dailyPnl          Decimal               @default(0) @db.Decimal(36, 18)
  dailyOpeningNav   Decimal               @default(0) @db.Decimal(36, 18)
  dailyPnlRatio     Decimal               @default(0) @db.Decimal(36, 18)
  dailyBaselineAt   DateTime?
  weeklyPnl         Decimal               @default(0) @db.Decimal(36, 18)
  weeklyOpeningNav  Decimal               @default(0) @db.Decimal(36, 18)
  weeklyPnlRatio    Decimal               @default(0) @db.Decimal(36, 18)
  weeklyBaselineAt  DateTime?
  drawdown          Decimal               @default(0) @db.Decimal(36, 18)
  marginUsed        Decimal               @default(0) @db.Decimal(36, 18)
  availableMargin   Decimal               @default(0) @db.Decimal(36, 18)
  grossExposure     Decimal               @default(0) @db.Decimal(36, 18)
  netExposure       Decimal               @default(0) @db.Decimal(36, 18)
  fundingPnl        Decimal               @default(0) @db.Decimal(36, 18)
  fees              Decimal               @default(0) @db.Decimal(36, 18)
  consecutiveLosses Int                   @default(0)
  grossRealizedPnl  Decimal               @default(0) @db.Decimal(36, 18)
  netRealizedPnl    Decimal               @default(0) @db.Decimal(36, 18)
  slippageCost      Decimal               @default(0) @db.Decimal(36, 18)
  liquidationPenalty Decimal              @default(0) @db.Decimal(36, 18)
  updatedAt         DateTime              @updatedAt
  strategy          Strategy              @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  allocations       StrategyAllocation[]
  positions         Position[]
  pnl               StrategyPnL[]
  navSnapshots      NavSnapshot[]
  futuresPositions  FuturesPosition[]
}

model StrategyAllocation {
  id                String          @id @default(uuid()) @db.Uuid
  strategyAccountId String          @db.Uuid
  symbol            String          @db.VarChar(16)
  targetWeight      Decimal         @db.Decimal(18, 8)
  maxWeight         Decimal         @db.Decimal(18, 8)
  enabled           Boolean         @default(true)
  account           StrategyAccount @relation(fields: [strategyAccountId], references: [id], onDelete: Restrict)

  @@unique([strategyAccountId, symbol])
}

model StrategyCycle {
  id         String              @id @default(uuid()) @db.Uuid
  strategyId String              @db.Uuid
  cycleId    String              @db.VarChar(128)
  status     StrategyCycleStatus @default(RUNNING)
  startedAt  DateTime            @default(now())
  finishedAt DateTime?
  error      String?             @db.VarChar(1024)
  strategy   Strategy            @relation(fields: [strategyId], references: [id], onDelete: Restrict)

  @@unique([strategyId, cycleId])
  @@index([status, startedAt])
}

model TradeSignal {
  id         String         @id @default(uuid()) @db.Uuid
  strategyId String         @db.Uuid
  cycleId    String         @db.VarChar(128)
  symbol     String         @db.VarChar(16)
  type       SignalType
  strength   Decimal        @db.Decimal(18, 8)
  price      Decimal        @db.Decimal(36, 18)
  indicators Json
  rationale  Json
  createdAt  DateTime       @default(now())
  strategy   Strategy       @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  proposal   TradeProposal?

  @@unique([strategyId, cycleId, symbol])
}

model TradeProposal {
  id                String         @id @default(uuid()) @db.Uuid
  strategyId        String         @db.Uuid
  signalId          String         @unique @db.Uuid
  cycleId           String         @db.VarChar(128)
  symbol            String         @db.VarChar(16)
  side              ProposalSide
  requestedNotional Decimal        @db.Decimal(36, 18)
  approvedNotional  Decimal?       @db.Decimal(36, 18)
  referencePrice    Decimal        @db.Decimal(36, 18)
  requestedLeverage Decimal?       @db.Decimal(18, 8)
  approvedLeverage  Decimal?       @db.Decimal(18, 8)
  stopLoss          Decimal?       @db.Decimal(36, 18)
  takeProfit        Decimal?       @db.Decimal(36, 18)
  maxSlippage       Decimal?       @db.Decimal(18, 8)
  reason            String?        @db.VarChar(256)
  status            ProposalStatus @default(CREATED)
  createdAt         DateTime       @default(now())
  strategy          Strategy       @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  signal            TradeSignal    @relation(fields: [signalId], references: [id], onDelete: Restrict)
  riskDecision      RiskDecision?
  paperOrder        PaperOrder?

  @@index([strategyId, createdAt])
}

model RiskDecision {
  id                String           @id @default(uuid()) @db.Uuid
  proposalId        String           @unique @db.Uuid
  decision          RiskDecisionType
  requestedNotional Decimal          @db.Decimal(36, 18)
  approvedNotional  Decimal          @db.Decimal(36, 18)
  reasonCodes       Json
  metrics           Json
  createdAt         DateTime         @default(now())
  proposal          TradeProposal    @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  paperOrder        PaperOrder?
}

model PaperOrder {
  id             String           @id @default(uuid()) @db.Uuid
  proposalId     String           @unique @db.Uuid
  riskDecisionId String           @unique @db.Uuid
  cycleId        String           @db.VarChar(128)
  symbol         String           @db.VarChar(16)
  side           PaperSide
  type           PaperOrderType   @default(MARKET)
  status         PaperOrderStatus @default(CREATED)
  quantity       Decimal          @db.Decimal(36, 18)
  notional       Decimal          @db.Decimal(36, 18)
  referencePrice Decimal          @db.Decimal(36, 18)
  leverage       Decimal?         @db.Decimal(18, 8)
  reduceOnly     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  proposal       TradeProposal    @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  riskDecision   RiskDecision     @relation(fields: [riskDecisionId], references: [id], onDelete: Restrict)
  executions     PaperExecution[]

  @@index([status, createdAt])
}

model FuturesPosition {
  id                  String               @id @default(uuid()) @db.Uuid
  strategyAccountId   String               @db.Uuid
  symbol              String               @db.VarChar(24)
  priceSourcePair     String               @db.VarChar(24)
  side                FuturesPositionSide
  status              PositionStatus       @default(OPEN)
  quantity            Decimal              @db.Decimal(36, 18)
  averageEntry        Decimal              @db.Decimal(36, 18)
  markPrice           Decimal              @db.Decimal(36, 18)
  leverage            Decimal              @db.Decimal(18, 8)
  notional            Decimal              @db.Decimal(36, 18)
  initialMargin       Decimal              @db.Decimal(36, 18)
  maintenanceMargin   Decimal              @db.Decimal(36, 18)
  liquidationPrice    Decimal              @db.Decimal(36, 18)
  liquidationDistance Decimal              @db.Decimal(18, 8)
  realizedPnl         Decimal              @default(0) @db.Decimal(36, 18)
  unrealizedPnl       Decimal              @default(0) @db.Decimal(36, 18)
  fundingPnl          Decimal              @default(0) @db.Decimal(36, 18)
  fees                Decimal              @default(0) @db.Decimal(36, 18)
  stopLoss            Decimal              @db.Decimal(36, 18)
  takeProfit          Decimal?             @db.Decimal(36, 18)
  trailingStop        Decimal?             @db.Decimal(36, 18)
  highestMarkPrice    Decimal?             @db.Decimal(36, 18)
  lowestMarkPrice     Decimal?             @db.Decimal(36, 18)
  markedAt            DateTime?
  openedAt            DateTime             @default(now())
  closedAt            DateTime?
  updatedAt           DateTime             @updatedAt
  account             StrategyAccount      @relation(fields: [strategyAccountId], references: [id], onDelete: Restrict)
  fundingPayments     FundingPayment[]
  liquidations        FuturesLiquidation[]

  @@unique([strategyAccountId, symbol])
  @@index([status, markedAt])
}

model FundingPayment {
  id             String          @id @default(uuid()) @db.Uuid
  positionId     String          @db.Uuid
  idempotencyKey String          @unique @db.VarChar(160)
  fundingRate    Decimal         @db.Decimal(18, 10)
  notional       Decimal         @db.Decimal(36, 18)
  payment        Decimal         @db.Decimal(36, 18)
  fundedAt       DateTime
  createdAt      DateTime        @default(now())
  position       FuturesPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([positionId, fundedAt])
}

model FuturesLiquidation {
  id               String          @id @default(uuid()) @db.Uuid
  positionId       String          @db.Uuid
  cycleId          String          @unique @db.VarChar(128)
  liquidationPrice Decimal         @db.Decimal(36, 18)
  fillPrice        Decimal         @db.Decimal(36, 18)
  penalty          Decimal         @db.Decimal(36, 18)
  realizedLoss     Decimal         @db.Decimal(36, 18)
  createdAt        DateTime        @default(now())
  position         FuturesPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
}

model PaperExecution {
  id            String     @id @default(uuid()) @db.Uuid
  orderId       String     @db.Uuid
  fillPrice     Decimal    @db.Decimal(36, 18)
  quantity      Decimal    @db.Decimal(36, 18)
  grossNotional Decimal    @db.Decimal(36, 18)
  fee           Decimal    @db.Decimal(36, 18)
  slippageBps   Decimal    @db.Decimal(18, 8)
  sourcePrice   Decimal?   @db.Decimal(36, 18)
  slippageCost  Decimal    @default(0) @db.Decimal(36, 18)
  executedAt    DateTime   @default(now())
  order         PaperOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, executedAt])
}

model Position {
  id                String          @id @default(uuid()) @db.Uuid
  strategyAccountId String          @db.Uuid
  symbol            String          @db.VarChar(16)
  status            PositionStatus  @default(OPEN)
  quantity          Decimal         @default(0) @db.Decimal(36, 18)
  averageEntry      Decimal         @default(0) @db.Decimal(36, 18)
  markPrice         Decimal         @default(0) @db.Decimal(36, 18)
  marketValue       Decimal         @default(0) @db.Decimal(36, 18)
  realizedPnl       Decimal         @default(0) @db.Decimal(36, 18)
  unrealizedPnl     Decimal         @default(0) @db.Decimal(36, 18)
  stopLoss          Decimal?        @db.Decimal(36, 18)
  takeProfit        Decimal?        @db.Decimal(36, 18)
  trailingStop      Decimal?        @db.Decimal(36, 18)
  markedAt          DateTime?
  openedAt          DateTime        @default(now())
  closedAt          DateTime?
  updatedAt         DateTime        @updatedAt
  account           StrategyAccount @relation(fields: [strategyAccountId], references: [id], onDelete: Restrict)
  lots              PositionLot[]

  @@unique([strategyAccountId, symbol])
}

model PositionLot {
  id         String    @id @default(uuid()) @db.Uuid
  positionId String    @db.Uuid
  quantity   Decimal   @db.Decimal(36, 18)
  entryPrice Decimal   @db.Decimal(36, 18)
  fee        Decimal   @default(0) @db.Decimal(36, 18)
  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  position   Position  @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([positionId, openedAt])
}

model StrategyPnL {
  id                String          @id @default(uuid()) @db.Uuid
  strategyAccountId String          @db.Uuid
  periodStart       DateTime
  periodEnd         DateTime
  realizedPnl       Decimal         @db.Decimal(36, 18)
  unrealizedPnl     Decimal         @db.Decimal(36, 18)
  fees              Decimal         @db.Decimal(36, 18)
  nav               Decimal         @db.Decimal(36, 18)
  account           StrategyAccount @relation(fields: [strategyAccountId], references: [id], onDelete: Restrict)

  @@unique([strategyAccountId, periodStart, periodEnd])
}

model NavSnapshot {
  id                String          @id @default(uuid()) @db.Uuid
  strategyAccountId String          @db.Uuid
  nav               Decimal         @db.Decimal(36, 18)
  cash              Decimal         @db.Decimal(36, 18)
  reserve           Decimal         @db.Decimal(36, 18)
  exposure          Decimal         @db.Decimal(36, 18)
  realizedPnl       Decimal         @db.Decimal(36, 18)
  unrealizedPnl     Decimal         @db.Decimal(36, 18)
  drawdown          Decimal         @db.Decimal(18, 8)
  capturedAt        DateTime        @default(now())
  account           StrategyAccount @relation(fields: [strategyAccountId], references: [id], onDelete: Restrict)

  @@index([strategyAccountId, capturedAt])
}

model MarketDataSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  source     String   @db.VarChar(32)
  symbol     String   @db.VarChar(16)
  timeframe  String   @db.VarChar(16)
  price      Decimal  @db.Decimal(36, 18)
  payload    Json
  observedAt DateTime
  staleAfter DateTime
  createdAt  DateTime @default(now())

  @@index([symbol, observedAt])
}

model RiskEvent {
  id         String                 @id @default(uuid()) @db.Uuid
  strategyId String?                @db.Uuid
  severity   ReconciliationSeverity
  code       String                 @db.VarChar(128)
  message    String                 @db.VarChar(512)
  details    Json
  resolvedAt DateTime?
  createdAt  DateTime               @default(now())

  @@index([severity, createdAt])
}

model CircuitBreakerState {
  id          String               @id @default(uuid()) @db.Uuid
  strategyId  String               @unique @db.Uuid
  status      CircuitBreakerStatus @default(RUNNING)
  reason      String?              @db.VarChar(512)
  triggeredAt DateTime?
  updatedAt   DateTime             @updatedAt
  strategy    Strategy             @relation(fields: [strategyId], references: [id], onDelete: Restrict)
}

model AssetConfig {
  id               String   @id @default(uuid()) @db.Uuid
  symbol           String   @unique @db.VarChar(16)
  enabled          Boolean  @default(true)
  quoteAsset       String   @default("USDC") @db.VarChar(12)
  maxWeight        Decimal  @db.Decimal(18, 8)
  minOrderNotional Decimal  @db.Decimal(36, 18)
  priceDecimals    Int
  quantityDecimals Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model StrategyActivity {
  id         String               @id @default(uuid()) @db.Uuid
  strategyId String?              @db.Uuid
  type       StrategyActivityType
  agentName  String               @db.VarChar(64)
  message    String               @db.VarChar(512)
  status     String               @db.VarChar(64)
  metadata   Json
  createdAt  DateTime             @default(now())
  strategy   Strategy?            @relation(fields: [strategyId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

model StrategyShare {
  id          String   @id @default(uuid()) @db.Uuid
  strategyId  String   @db.Uuid
  enabled     Boolean  @default(false)
  totalShares Decimal  @default(0) @db.Decimal(36, 18)
  createdAt   DateTime @default(now())

  @@index([strategyId])
}

model RewardFundState {
  id                          String       @id @default(uuid()) @db.Uuid
  mode                        RewardMode   @unique
  aggregateSettlementNav      Decimal      @default(0) @db.Decimal(36, 18)
  highWaterMark               Decimal      @default(0) @db.Decimal(36, 18)
  lossCarryforward            Decimal      @default(0) @db.Decimal(36, 18)
  cumulativeNetRealized       Decimal      @default(0) @db.Decimal(36, 18)
  cumulativeDistributedProfit Decimal      @default(0) @db.Decimal(36, 18)
  lastEpochNumber             Int          @default(0)
  lastFinalizedEpochId        String?      @unique @db.Uuid
  updatedAt                   DateTime     @updatedAt
  lastFinalizedEpoch          RewardEpoch? @relation("LastFinalizedRewardEpoch", fields: [lastFinalizedEpochId], references: [id], onDelete: Restrict)
}

model RewardSettlementCursor {
  id                 String     @id @default(uuid()) @db.Uuid
  mode               RewardMode @default(PAPER)
  strategyCode       String     @db.VarChar(64)
  realizedPnl        Decimal    @default(0) @db.Decimal(36, 18)
  grossRealizedPnl   Decimal    @default(0) @db.Decimal(36, 18)
  fees               Decimal    @default(0) @db.Decimal(36, 18)
  fundingPnl         Decimal    @default(0) @db.Decimal(36, 18)
  slippageCost       Decimal    @default(0) @db.Decimal(36, 18)
  liquidationPenalty Decimal   @default(0) @db.Decimal(36, 18)
  nav                Decimal    @default(0) @db.Decimal(36, 18)
  updatedAt          DateTime   @updatedAt

  @@unique([mode, strategyCode])
}

model EpochSettlementBaseline {
  id                     String      @id @default(uuid()) @db.Uuid
  rewardEpochId          String      @db.Uuid
  strategyCode           String      @db.VarChar(64)
  nav                    Decimal     @db.Decimal(36, 18)
  realizedPnl            Decimal     @db.Decimal(36, 18)
  grossRealizedPnl       Decimal     @db.Decimal(36, 18)
  fees                   Decimal     @db.Decimal(36, 18)
  fundingPnl             Decimal     @db.Decimal(36, 18)
  slippageCost           Decimal     @db.Decimal(36, 18)
  liquidationPenalty     Decimal     @db.Decimal(36, 18)
  capturedAt             DateTime    @default(now())
  rewardEpoch            RewardEpoch @relation(fields: [rewardEpochId], references: [id], onDelete: Restrict)

  @@unique([rewardEpochId, strategyCode])
  @@index([strategyCode, capturedAt])
}

model SettlementSourceSnapshot {
  id                 String      @id @default(uuid()) @db.Uuid
  rewardEpochId      String      @db.Uuid
  strategyCode       String      @db.VarChar(64)
  startNav           Decimal     @db.Decimal(36, 18)
  endNav             Decimal     @db.Decimal(36, 18)
  grossRealizedPnl   Decimal     @db.Decimal(36, 18)
  tradingFees        Decimal     @db.Decimal(36, 18)
  fundingPnl         Decimal     @db.Decimal(36, 18)
  slippageCost       Decimal     @db.Decimal(36, 18)
  liquidationPenalty Decimal     @db.Decimal(36, 18)
  netRealizedPnl     Decimal     @db.Decimal(36, 18)
  cumulativeRealizedPnl Decimal  @db.Decimal(36, 18)
  cumulativeGrossRealizedPnl Decimal @db.Decimal(36, 18)
  cumulativeFees Decimal         @db.Decimal(36, 18)
  cumulativeFundingPnl Decimal   @db.Decimal(36, 18)
  cumulativeSlippageCost Decimal @db.Decimal(36, 18)
  cumulativeLiquidationPenalty Decimal @db.Decimal(36, 18)
  frozenAt           DateTime    @default(now())
  rewardEpoch        RewardEpoch @relation(fields: [rewardEpochId], references: [id], onDelete: Restrict)

  @@unique([rewardEpochId, strategyCode])
}

model UserRewardAllocation {
  id            String           @id @default(uuid()) @db.Uuid
  rewardEpochId String           @db.Uuid
  userId        String           @db.Uuid
  principalXp   Decimal          @db.Decimal(36, 18)
  dynamicXp     Decimal          @db.Decimal(36, 18)
  totalXp       Decimal          @db.Decimal(36, 18)
  globalTotalXp Decimal          @db.Decimal(36, 18)
  shareRatio    Decimal          @db.Decimal(36, 18)
  grossReward   Decimal          @db.Decimal(36, 18)
  feeRate       Decimal          @db.Decimal(18, 8)
  withdrawalFee Decimal          @db.Decimal(36, 18)
  netReward     Decimal          @db.Decimal(36, 18)
  status        UserRewardStatus @default(PENDING)
  mode          RewardMode       @default(PAPER)
  createdAt     DateTime         @default(now())
  availableAt   DateTime?
  withdrawnAt   DateTime?
  rewardEpoch   RewardEpoch      @relation(fields: [rewardEpochId], references: [id], onDelete: Restrict)
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([rewardEpochId, userId])
  @@index([userId, status])
}

model RewardAuditEvent {
  id            String      @id @default(uuid()) @db.Uuid
  rewardEpochId String      @db.Uuid
  type          String      @db.VarChar(64)
  actorId       String?     @db.Uuid
  details       Json
  createdAt     DateTime    @default(now())
  rewardEpoch   RewardEpoch @relation(fields: [rewardEpochId], references: [id], onDelete: Restrict)

  @@index([rewardEpochId, createdAt])
  @@unique([rewardEpochId, type])
}
